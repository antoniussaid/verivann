# Verivann — example environment. Copy to `.env` (never committed).

# Where staged notes + events are written (the private layer picks them up here).
VERIVANN_STAGING=data/staging

# Path to a PRIVATE config file (owned by the private layer, never committed).
# It may inject the real domain registry and flip public_demo off. Example shape:
#   { "domains": ["...","..."], "public_demo": false }
# VERIVANN_PRIVATE_CONFIG=private/private-config.json

# ----- LLM analyzer (optional) -----
# Leave unset -> the offline heuristic analyzes (free, no key, public default).
# Set a provider to let a model fill summary / ideas / claims / actions.
# Provider is one of: openai | ollama | anthropic
#
# Local & sovereign (recommended for the private layer — data stays on your machine):
#   VERIVANN_LLM=ollama
#   VERIVANN_LLM_MODEL=llama3.2:3b
#   # base_url defaults to http://localhost:11434/v1 ; key not needed
#
# Cloud (stronger; data leaves your machine, costs per call):
#   VERIVANN_LLM=openai
#   VERIVANN_LLM_MODEL=gpt-4o-mini
#   VERIVANN_LLM_API_KEY=sk-...
#
#   VERIVANN_LLM=anthropic
#   VERIVANN_LLM_MODEL=claude-haiku-4-5-20251001
#   VERIVANN_LLM_API_KEY=sk-ant-...
#
# Optional override for any OpenAI-compatible endpoint (LM Studio, OpenRouter…):
#   VERIVANN_LLM_BASE_URL=http://localhost:1234/v1

# ----- Local transcription fallback (optional, heavy) -----
# Only used when a video has NO captions. Downloads audio + transcribes locally.
# Install: pip install -e ".[whisper]"
#   VERIVANN_WHISPER_MODEL=tiny      # tiny|base|small|medium|large-v3 (bigger = better, slower)
#   # HF_HOME=/path/on/big/disk   # redirect the model cache off a full drive
# Or use a whisper.cpp binary instead of faster-whisper:
#   VERIVANN_WHISPER_CPP=whisper-cli
#   VERIVANN_WHISPER_CPP_MODEL=/path/to/ggml-base.bin

# ----- Privacy: what is allowed to leave this machine -----
# Verivann reads your screenshots, voice memos and PDFs. Anything off your own disk —
# and anything carrying an IBAN, a diagnosis, a salary or a credential — is
# classified `sensitive`. Under the default policy it is NEVER sent to a hosted
# model. It goes to the local slot, or to nobody (and the note says which).
#   VERIVANN_PRIVACY=strict            # strict (default) | allow
#   VERIVANN_LOCAL_LLM=ollama          # the slot that never leaves the machine
#   VERIVANN_LOCAL_LLM_MODEL=llama3.2:3b
# What actually left, and what it cost:  `verivann outbound`
#   VERIVANN_PRICE_PER_MTOK=3.0        # € per million tokens; without it, no cost is invented

# ----- Counter-search (optional) -----
# So the note can stop saying "unsupported claim" and go find the other side.
# Self-hosted SearXNG (no key, no terms to violate) or Brave's API.
# Verivann does not scrape engines whose terms forbid it.
#   VERIVANN_SEARCH_URL=http://localhost:8888
#   VERIVANN_SEARCH_KEY=...            # Brave, alternatively

# ----- Meaning search (optional) -----
# Keyword search finds the word you typed. Embeddings find the note you meant.
# Any OpenAI-compatible /embeddings endpoint. Local and free with Ollama:
#   VERIVANN_EMBED_MODEL=nomic-embed-text
#   # VERIVANN_EMBED_BASE_URL=http://localhost:11434/v1   # defaults to the chat provider's
#   # (Anthropic has no embeddings endpoint — point BASE_URL at one that does.)
# Then: `verivann reindex` to embed everything already digested.

# ----- Accepting notes (optional) -----
# Where `verivann accept <id>` writes — an Obsidian vault, a git repo, any folder.
# This is the ONLY place a proposal becomes a commitment, and only by your command.
#   VERIVANN_ACCEPT_DIR=D:/vault/inbox

# ----- Reading intent / lens (optional) -----
# The default lens for every intake. `--lens` overrides it per source.
# One of: digest | wisdom | critique | study | actions   (see `verivann lenses`)
# Lenses steer the LLM analyzer; without an LLM the lens is recorded but idle.
#   VERIVANN_LENS=digest

# ----- Raw archive (optional) -----
# Keep the evidence the note was made from — a faithful snapshot of the page.
# Every format comes from an external program (called as a subprocess, never
# bundled), so install only what you want:
#   VERIVANN_ARCHIVE=1
#   VERIVANN_ARCHIVE_FORMATS=html,pdf,png     # default: html
#   # html      -> `monolith` (GPL-2.0) or `single-file` (AGPL)
#   # pdf, png  -> headless Chrome/Edge (already on most machines; auto-detected)
#   # VERIVANN_CHROME=/path/to/chrome         # only if auto-detection fails
