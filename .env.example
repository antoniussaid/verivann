# Verivann — configuration. Copy this to `.env` (which is never committed).
#
# Everything here is OPTIONAL. With no config at all, Verivann runs offline on a
# keyword heuristic — free, private, no account. A model just makes it much better.
#
# The easy way to fill this in: run `verivann setup`.

# ============================================================================
#  A model (optional, but this is where the tool comes alive)
# ============================================================================
# Verivann speaks the OpenAI wire format, so almost any provider works with a
# preset. Pick ONE. All of these have a free tier.

# --- Free & hosted ---
#
# Cloudflare Workers AI — if antonius.app runs on Cloudflare you already have this:
#   VERIVANN_LLM=cloudflare
#   VERIVANN_CF_ACCOUNT_ID=<your account id>
#   VERIVANN_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
#   VERIVANN_LLM_API_KEY=<your token>
#
# Groq — fast, generous free tier:
#   VERIVANN_LLM=groq
#   VERIVANN_LLM_MODEL=llama-3.3-70b-versatile
#   VERIVANN_LLM_API_KEY=gsk_...
#
# OpenRouter (many models, some free) / Google Gemini (free tier):
#   VERIVANN_LLM=openrouter   VERIVANN_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   VERIVANN_LLM=gemini       VERIVANN_LLM_MODEL=gemini-2.0-flash

# --- Local & private (nothing ever leaves your machine) ---
#   VERIVANN_LLM=ollama       VERIVANN_LLM_MODEL=llama3.2:3b      # ollama.com
#   VERIVANN_LLM=lmstudio     VERIVANN_LLM_MODEL=<model in LM Studio>

# --- Paid, if you want the strongest ---
#   VERIVANN_LLM=openai       VERIVANN_LLM_MODEL=gpt-4o-mini      VERIVANN_LLM_API_KEY=sk-...
#   VERIVANN_LLM=anthropic    VERIVANN_LLM_MODEL=claude-haiku-4-5-20251001  VERIVANN_LLM_API_KEY=sk-ant-...

# --- Any OpenAI-compatible endpoint, by hand ---
#   VERIVANN_LLM_BASE_URL=http://localhost:1234/v1

# Free tiers rate-limit. Give the chain somewhere to fall:
#   VERIVANN_LLM_MODELS=<second model on the same endpoint>,<third>
#   VERIVANN_LLM_FALLBACK=groq          # a whole other provider when this one is exhausted

# Meaning-search (finds the note you MEANT, not just the words you typed):
#   VERIVANN_EMBED_MODEL=nomic-embed-text     # then run `verivann reindex`
#   # VERIVANN_EMBED_BASE_URL=...   defaults to the chat provider's endpoint

# ============================================================================
#  Privacy — what is allowed to leave this machine
# ============================================================================
# Anything from your own disk (screenshots, voice memos, PDFs) or carrying an
# IBAN, a diagnosis, a salary or a credential is `sensitive`. By default it is
# NEVER sent to a hosted model — it goes to a local model, or to nobody, and the
# note says which.
#   VERIVANN_PRIVACY=strict             # strict (default) | allow
#   VERIVANN_LOCAL_LLM=ollama           # the slot that never leaves the machine
#   VERIVANN_LOCAL_LLM_MODEL=llama3.2:3b
#
# No local model, but you still want sensitive files analyzed? Redact first:
# identity (names, IBANs, amounts) is stripped on THIS machine, only the
# placeholder text is sent, and the note is restored locally.
#   VERIVANN_REDACT=1
#
# What actually left this machine, and what it cost:  `verivann outbound`
#   VERIVANN_PRICE_PER_MTOK=3.0         # € per million tokens; without it, no cost is invented

# ============================================================================
#  Video & media policy — the one thing the law cares about
# ============================================================================
# Verivann reads a video's published CAPTIONS (plain text, no download). It only
# fetches the media file when there is no other way to know what was said — and on
# platforms that protect their stream (YouTube, Netflix, Spotify…) it NEVER does,
# because that would be circumvention. That rule is not configurable.
#   VERIVANN_MEDIA=fallback   # off | fallback (default) | ask | always
#   VERIVANN_MEDIA_KEEP=1     # keep the downloaded file (default: delete after transcript)
#
# Local transcription, used only when a video has no captions (heavy, opt-in):
#   VERIVANN_WHISPER_MODEL=base         # tiny|base|small|medium|large-v3
#   # VERIVANN_WHISPER_CPP=whisper-cli  VERIVANN_WHISPER_CPP_MODEL=/path/ggml-base.bin

# ============================================================================
#  Everything else (all optional)
# ============================================================================
# Where staged notes + events are written:
#   VERIVANN_STAGING=data/staging

# Default reading lens (digest | wisdom | critique | study | actions):
#   VERIVANN_LENS=digest

# `verivann accept <id>` writes an accepted note here — an Obsidian vault, any folder.
# This is the ONLY place a proposal becomes a commitment, and only by your command.
#   VERIVANN_ACCEPT_DIR=/path/to/vault/inbox

# Counter-search — so a note can go find the OTHER side of a claim.
# Self-hosted SearXNG (no key) or Brave's API. Verivann never scrapes engines
# whose terms forbid it.
#   VERIVANN_SEARCH_URL=http://localhost:8888
#   VERIVANN_SEARCH_KEY=...             # Brave, alternatively

# Raw archive — keep the page as evidence. External tools, invoked, never bundled:
#   VERIVANN_ARCHIVE=1
#   VERIVANN_ARCHIVE_FORMATS=html,pdf,png    # html -> monolith/single-file; pdf/png -> headless Chrome

# On-screen text in videos (ffmpeg keyframes + tesseract OCR):
#   VERIVANN_VISUAL=1

# A private config file (never committed) may inject a different domain registry:
#   VERIVANN_PRIVATE_CONFIG=private/config.json
